<view class="container container--no-tabbar">
  <view class="page-header">
    <view class="g-flex-between">
      <view class="back-btn" bindtap="onBack">
        <text class="iconfont icon-arrow-left iconfont--primary iconfont--sm"></text>
      </view>
      <view class="page-header__title">导出记录</view>
      <view class="page-header__placeholder"></view>
    </view>
  </view>

  <view class="g-spacer-md"></view>

  <view class="g-card">
    <view class="g-card__title">导出格式</view>

    <view class="g-list format-list">
      <view class="g-list-item">
        <view class="g-list-item__content">
          <view class="g-list-item__title">文件格式</view>
        </view>
        <view class="g-list-item__right">
          <text class="g-text-bold">CSV</text>
        </view>
      </view>
      <view class="g-list-item">
        <view class="g-list-item__content">
          <view class="g-list-item__title">文件名</view>
        </view>
        <view class="g-list-item__right">
          <text class="g-text-muted">inject_年月日.csv</text>
        </view>
      </view>
      <view class="g-list-item">
        <view class="g-list-item__content">
          <view class="g-list-item__title">保存位置</view>
        </view>
        <view class="g-list-item__right">
          <text class="g-text-muted save-path">{{savePath}}</text>
        </view>
      </view>
    </view>

    <view class="g-spacer-md"></view>

    <view class="fields-section">
      <view class="fields-title">导出字段</view>
      <view class="fields-list">
        <view class="g-tag g-tag--primary">药物名称</view>
        <view class="g-tag g-tag--primary">规格</view>
        <view class="g-tag g-tag--primary">日期</view>
        <view class="g-tag g-tag--primary">剂量 (mg)</view>
        <view class="g-tag g-tag--primary">部位</view>
      </view>
    </view>

    <view class="g-spacer-md"></view>

    <view class="action-section">
      <button class="export-btn" bindtap="onExport">
        导出记录
      </button>
    </view>

    <view class="share-section" wx:if="{{exportPath}}">
      <button class="share-btn" bindtap="onShareFile">
        分享文件
      </button>
    </view>
  </view>

  <view class="g-card">
    <view class="g-card__title">使用说明</view>
    <view class="tip-item">1. 导出的CSV文件可用Excel或表格软件打开</view>
    <view class="tip-item">2. 文件保存至微信本地文件目录</view>
    <view class="tip-item">3. 导出后可点击"打开"直接查看文件内容</view>
    <view class="tip-item">4. 支持通过微信分享给好友或保存到云盘</view>
  </view>
</view>