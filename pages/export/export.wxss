.format-list {
  margin: 0;
  box-shadow: none;
  border-radius: var(--r-md);
  background: var(--c-gray-1);
  padding: var(--s-1);
}

.format-list .g-list-item {
  background: var(--c-surface);
  border-radius: var(--r-sm);
  margin-bottom: var(--s-1);
  border-bottom: none;
  min-height: auto;
  padding: var(--s-2);
}

.format-list .g-list-item:last-child {
  margin-bottom: 0;
}

.save-path {
  max-width: 400rpx;
  font-size: var(--f-caption);
  word-break: break-all;
  text-align: right;
}

.fields-section {
  padding: 0;
}

.fields-title {
  font-size: var(--f-title2);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  margin-bottom: var(--s-2);
  line-height: var(--lh-relaxed);
}

.fields-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-1);
}

.fields-list .g-tag {
  display: inline-flex;
  align-items: center;
  gap: var(--s-1);
  height: 52rpx;
  padding: 0 var(--s-2);
  font-size: var(--f-caption);
}

.g-card__title {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  font-size: var(--f-title2);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  margin-bottom: var(--s-2);
  line-height: var(--lh-relaxed);
}

.action-section {
  margin-bottom: var(--s-2);
}

.export-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: var(--f-title1);
  font-weight: var(--fw-medium);
  border-radius: var(--r-md);
  border: none;
  line-height: 1;
  padding: 0;
  margin: 0;
}

.export-btn::before {
  content: none;
}

.export-btn::after {
  border: none;
}

.share-section {
  text-align: center;
}

.share-btn {
  display: inline-block;
  height: 64rpx;
  padding: 0 32rpx;
  background: #fff;
  color: #2563EB;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 32rpx;
  border: 1rpx solid #2563EB;
  line-height: 64rpx;
}

.share-btn::after {
  border: none;
}

.tip-item {
  font-size: var(--f-caption);
  color: var(--c-text-2);
  line-height: var(--lh-relaxed);
  padding: var(--s-1) 0;
}