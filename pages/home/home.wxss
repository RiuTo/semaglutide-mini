/* ===== 蓝色渐变头部 ===== */
.home-header {
  background: linear-gradient(165deg, #2563EB 0%, #3B82F6 55%, #60A5FA 100%);
  border-radius: 0 0 32rpx 32rpx;
  padding: 0 24rpx 32rpx;
}

.header-safe-top {
  height: var(--safe-top);
}

.header-title-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
}

.header-title-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

/* ===== 白色药品信息卡片 ===== */
.header-drug-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.08);
  padding: 32rpx;
  margin-top: 16rpx;
}

.drug-card-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 左侧圆形图标 */
.drug-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #EFF6FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.drug-icon-circle .iconfont {
  font-size: 48rpx;
  color: #2563EB;
}

/* 中间药品信息 */
.drug-info-main {
  flex: 1;
  min-width: 0;
}

.drug-name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.drug-name-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #1E293B;
}

.drug-brand-tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 22rpx;
  font-weight: 500;
}

.drug-spec-desc {
  font-size: 26rpx;
  color: #64748B;
}

/* 右侧剩余百分比 */
.drug-remain-pct {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding-left: 24rpx;
  min-width: 100rpx;
}

.drug-remain-pct__num {
  font-size: 40rpx;
  font-weight: 500;
  color: #2563EB;
  line-height: 1.2;
}

.drug-remain-pct__label {
  font-size: 22rpx;
  color: #94A3B8;
}

/* 进度条 */
.drug-progress-wrap {
  margin-top: 24rpx;
}

.drug-progress-track {
  height: 12rpx;
  background: #EFF6FF;
  border-radius: 6rpx;
  overflow: hidden;
}

.drug-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563EB, #3B82F6);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.drug-progress-caption {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #94A3B8;
}

/* 更换提示 */
.drug-replace-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #FFFBEB;
  border-radius: 16rpx;
  justify-content: space-between;
}

.drug-replace-tip .iconfont {
  font-size: 28rpx;
  color: #FBBF24;
}

.drug-replace-tip__text {
  font-size: 26rpx;
  color: #64748B;
  flex: 1;
  margin-left: 8rpx;
}

.drug-replace-btn {
  padding: 10rpx 24rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 28rpx;
  font-weight: var(--fw-medium);
}

/* ===== 原有样式保留 ===== */
.plan-row {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  margin-bottom: var(--s-2);
}

.plan-row--secondary {
  margin-bottom: var(--s-3);
}

.plan-text {
  font-size: var(--f-body);
  color: var(--c-text);
  font-weight: var(--fw-medium);
  line-height: var(--lh-relaxed);
}

.plan-text--muted {
  font-size: var(--f-caption);
  color: var(--c-text-3);
  font-weight: var(--fw-regular);
  line-height: var(--lh-relaxed);
}

.plan-btn {
  margin-top: var(--s-2);
}

.plan-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--s-4) 0;
}

.plan-empty__text {
  font-size: var(--f-body);
  color: var(--c-text-3);
  margin-bottom: var(--s-3);
  line-height: var(--lh-relaxed);
  font-weight: var(--fw-regular);
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: var(--s-3);
}

.record-icon--success {
  background: var(--c-success-container);
  color: var(--c-success);
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
  padding: 0 var(--gutter);
}

.record-card {
  display: flex;
  align-items: center;
  background: var(--c-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: var(--s-3);
  box-sizing: border-box;
}

.record-card__content {
  flex: 1;
  min-width: 0;
}

.record-card__title {
  font-size: var(--f-body);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  line-height: var(--lh-relaxed);
}

.record-card__desc {
  font-size: var(--f-caption);
  color: var(--c-text-3);
  line-height: var(--lh-relaxed);
  margin-top: 8rpx;
}

.view-all-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
