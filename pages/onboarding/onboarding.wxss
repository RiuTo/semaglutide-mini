.container {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--c-bg);
  padding-bottom: 300rpx;
}

.top-bar {
  padding: calc(var(--safe-top) + var(--safe-top)) var(--gutter) var(--s-5);
  background: var(--c-bg);
}

.steps-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--s-2);
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--c-gray-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--f-caption);
  color: var(--c-muted);
  transition: all 0.3s;
  line-height: var(--lh-relaxed);
  flex-shrink: 0;
  font-weight: var(--fw-medium);
}

.step-dot.active {
  background: var(--c-primary);
  color: var(--c-white);
  box-shadow: var(--shadow-pink);
}

.step-dot.done {
  background: var(--c-primary);
  color: var(--c-white);
}

.step-line {
  width: 150rpx;
  height: 4rpx;
  background: var(--c-gray-2);
  transition: all 0.3s;
  border-radius: var(--r-xs);
}

.step-line.active {
  background: var(--c-primary);
}

.welcome-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--s-6) var(--gutter) var(--s-5);
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, var(--c-primary-light) 0%, var(--c-bg) 45%, var(--c-bg) 100%);
}

.welcome-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-xl);
  background: linear-gradient(135deg, var(--c-primary-light) 0%, var(--c-primary) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--s-5);
  box-shadow: var(--shadow-pink);
}

.welcome-icon .iconfont {
  width: 160rpx;
  height: 160rpx;
  font-size: 80rpx;
}

.welcome-title {
  font-size: var(--f-xlarge);
  font-weight: var(--fw-semibold);
  color: var(--c-text);
  margin-bottom: var(--s-2);
  line-height: var(--lh-relaxed);
  text-align: center;
}

.welcome-subtitle {
  font-size: var(--f-body);
  color: var(--c-text-2);
  margin-bottom: var(--s-6);
  line-height: var(--lh-relaxed);
  text-align: center;
}

.welcome-features {
  width: 100%;
  margin-bottom: var(--s-6);
  box-sizing: border-box;
  background: var(--c-card);
  border-radius: var(--r-lg);
  padding: var(--s-2) var(--s-3);
  box-shadow: var(--shadow-card);
}

.feature-item {
  font-size: var(--f-body);
  color: var(--c-text);
  padding: var(--s-2) 0;
  border-bottom: 1rpx solid var(--c-divider);
  line-height: var(--lh-relaxed);
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-weight: var(--fw-medium);
}

.feature-item:last-child {
  border-bottom: none;
}

.welcome-btn {
  width: 100%;
}

.step-content {
  padding: var(--s-1) var(--gutter);
}

.step-header {
  margin-bottom: var(--s-5);
  padding: 0 var(--gutter);
}

.step-title {
  font-size: var(--f-title1);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  margin-bottom: var(--s-2);
  line-height: var(--lh-relaxed);
}

.step-desc {
  font-size: var(--f-body);
  color: var(--c-text-2);
  line-height: var(--lh-relaxed);
}

.drug-list {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  padding: 0 var(--gutter);
}

.drug-item {
  display: flex;
  align-items: center;
  transition: all 0.2s;
  box-sizing: border-box;
  padding: var(--s-3) var(--s-3);
  margin: 0;
  border-radius: var(--r-lg);
  background: var(--c-card);
  box-shadow: var(--shadow-card);
  border: 2rpx solid transparent;
}

.drug-item + .drug-item {
  margin-top: 0;
}

.drug-item.selected {
  background: var(--c-primary-container);
  border-color: var(--c-primary-light);
  box-shadow: var(--shadow-card);
}

.drug-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--c-gray-3);
  margin-right: var(--s-3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  flex-shrink: 0;
  background: var(--c-white);
}

.drug-item.selected .drug-check {
  border-color: var(--c-primary);
  background: var(--c-primary);
}

.drug-content {
  flex: 1;
  min-width: 0;
}

.check-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.drug-name {
  font-size: var(--f-title2);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  margin-bottom: var(--s-1);
  line-height: var(--lh-relaxed);
}

.drug-subtitle {
  font-size: var(--f-caption);
  color: var(--c-text-2);
  line-height: var(--lh-relaxed);
}

.spec-list {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}

.spec-item {
  display: flex;
  align-items: flex-start;
  transition: all 0.2s;
  box-sizing: border-box;
  padding: var(--s-3) var(--s-3);
  margin: 0 var(--gutter);
  border-radius: var(--r-lg);
  background: var(--c-card);
  box-shadow: var(--shadow-card);
  border: 2rpx solid transparent;
}

.spec-item + .spec-item {
  margin-top: 0;
}

.spec-item.selected {
  background: var(--c-primary-container);
  border-color: var(--c-primary-light);
  box-shadow: var(--shadow-card);
}

.spec-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--c-gray-3);
  margin-right: var(--s-3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
  background: var(--c-white);
}

.spec-item.selected .spec-check {
  border-color: var(--c-primary);
  background: var(--c-primary);
}

.spec-info {
  flex: 1;
  min-width: 0;
}

.spec-name {
  font-size: var(--f-body);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  margin-bottom: 0;
  line-height: var(--lh-relaxed);
}

.spec-doses {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
  margin-bottom: var(--s-2);
}

.spec-desc {
  font-size: var(--f-caption);
  color: var(--c-muted);
  line-height: var(--lh-relaxed);
}

.option-row {
  display: flex;
  gap: var(--s-2);
  margin-bottom: var(--s-4);
  padding: 0 var(--gutter);
}

.option-card {
  flex: 1;
  text-align: center;
  transition: all 0.2s;
  box-sizing: border-box;
  padding: var(--s-3) var(--s-2);
  margin: 0;
  border-radius: var(--r-lg);
  background: var(--c-card);
  box-shadow: var(--shadow-card);
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}

.option-card.selected {
  background: var(--c-primary-container);
  border-color: var(--c-primary-light);
  box-shadow: var(--shadow-card);
}

.option-icon {
  margin-bottom: var(--s-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-icon .iconfont {
  width: 48rpx;
  height: 48rpx;
  font-size: 48rpx;
}

.option-title {
  font-size: var(--f-title2);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  margin-bottom: var(--s-1);
  line-height: var(--lh-relaxed);
}

.option-desc {
  font-size: var(--f-caption);
  color: var(--c-text-2);
  line-height: var(--lh-relaxed);
}

.used-section {
  box-sizing: border-box;
}

.section-title {
  font-size: var(--f-title2);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  margin-bottom: var(--s-3);
  display: flex;
  align-items: center;
  line-height: var(--lh-relaxed);
}

.max-hint {
  font-size: var(--f-caption);
  color: var(--c-muted);
  font-weight: var(--fw-regular);
  margin-left: var(--s-1);
  line-height: var(--lh-relaxed);
}

.section-subtitle {
  font-size: var(--f-caption);
  color: var(--c-text-2);
  margin-bottom: var(--s-2);
  margin-top: var(--s-1);
  line-height: var(--lh-relaxed);
}

.dose-selector {
  margin-bottom: var(--s-3);
}

.dose-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
  margin-bottom: var(--s-2);
}

.dose-option {
  background: var(--c-gray-1);
  color: var(--c-text);
  border: 2rpx solid transparent;
  transition: all 0.2s;
  cursor: pointer;
  padding: 0 var(--s-2);
  height: 64rpx;
  line-height: 60rpx;
  font-size: var(--f-body);
  text-align: center;
  border-radius: var(--r-md);
  font-weight: var(--fw-medium);
  min-width: 96rpx;
  box-sizing: border-box;
}

.dose-option.selected {
  background: var(--c-primary-container);
  color: var(--c-primary);
  border-color: var(--c-primary-light);
  font-weight: var(--fw-medium);
}

.add-record-btn {
  margin-top: var(--s-2);
}

.add-icon {
  margin-right: var(--s-1);
}

.record-list {
  max-height: 400rpx;
  overflow-y: auto;
  margin-bottom: var(--s-3);
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-2) var(--s-3);
  background: var(--c-gray-1);
  border-radius: var(--r-md);
  margin-bottom: var(--s-2);
}

.record-item:last-child {
  margin-bottom: 0;
}

.record-dose {
  font-size: var(--f-body);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  line-height: var(--lh-relaxed);
}

.record-delete {
  font-size: var(--f-caption);
  color: var(--c-danger);
  padding: var(--s-1) var(--s-2);
  line-height: var(--lh-relaxed);
}

.empty-hint {
  text-align: center;
  font-size: var(--f-caption);
  color: var(--c-muted);
  padding: var(--s-4) 0;
  margin-bottom: var(--s-2);
  line-height: var(--lh-relaxed);
}

.remaining-card {
  background: var(--c-gray-1);
  border-radius: var(--r-md);
  padding: var(--s-3);
}

.remaining-header {
  margin-bottom: var(--s-2);
  font-size: var(--f-caption);
  color: var(--c-text-2);
  line-height: var(--lh-relaxed);
}

.remaining-percent {
  font-size: var(--f-title1);
  font-weight: var(--fw-medium);
  color: var(--c-primary);
  line-height: var(--lh-relaxed);
}

.progress-bar {
  height: 16rpx;
  background: var(--c-gray-2);
  border-radius: var(--r-xs);
  overflow: hidden;
  margin-bottom: var(--s-2);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--c-primary-light), var(--c-primary));
  border-radius: var(--r-xs);
  transition: width 0.3s;
}

.remaining-detail {
  font-size: var(--f-caption);
  color: var(--c-muted);
  text-align: right;
  line-height: var(--lh-relaxed);
}

.plan-options {
  display: flex;
  gap: var(--s-2);
  margin-bottom: var(--s-4);
  padding: 0 var(--gutter);
}

.plan-option {
  flex: 1;
  text-align: center;
  transition: all 0.2s;
  box-sizing: border-box;
  padding: var(--s-3) var(--s-2);
  margin: 0;
  border-radius: var(--r-lg);
  background: var(--c-card);
  box-shadow: var(--shadow-card);
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}

.plan-option.selected {
  background: var(--c-primary-container);
  border-color: var(--c-primary-light);
  box-shadow: var(--shadow-card);
}

.plan-icon {
  margin-bottom: var(--s-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-icon .iconfont {
  width: 48rpx;
  height: 48rpx;
  font-size: 48rpx;
}

.plan-name {
  font-size: var(--f-title2);
  font-weight: var(--fw-medium);
  color: var(--c-text);
  margin-bottom: var(--s-1);
  line-height: var(--lh-relaxed);
}

.plan-desc {
  font-size: var(--f-caption);
  color: var(--c-text-2);
  line-height: var(--lh-relaxed);
}

.date-section {
  box-sizing: border-box;
  margin-bottom: var(--s-5);
}

.date-picker {
  display: flex;
  align-items: center;
  background: var(--c-gray-1);
  border-radius: var(--r-md);
  padding: var(--s-3);
}

.date-icon {
  margin-right: var(--s-2);
}

.date-text {
  flex: 1;
  font-size: var(--f-body);
  color: var(--c-text);
  line-height: var(--lh-relaxed);
  font-weight: var(--fw-medium);
}

.date-arrow {
  font-size: var(--f-title1);
  color: var(--c-hint);
}

.summary-card {
  box-sizing: border-box;
}

.summary-title {
  font-size: var(--f-title1);
  font-weight: var(--fw-medium);
  color: var(--c-primary);
  margin-bottom: var(--s-3);
  text-align: center;
  line-height: var(--lh-relaxed);
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s-2) 0;
  border-bottom: 1rpx solid var(--c-divider);
}

.summary-item:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: var(--f-body);
  color: var(--c-text-2);
  line-height: var(--lh-relaxed);
}

.summary-value {
  font-size: var(--f-body);
  color: var(--c-text);
  font-weight: var(--fw-medium);
  line-height: var(--lh-relaxed);
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: var(--s-2);
  padding: var(--s-3) var(--gutter);
  padding-bottom: calc(var(--s-3) + env(safe-area-inset-bottom));
  background: var(--c-surface);
  box-shadow: var(--shadow-card);
}

.prev-btn {
  flex: 1;
}

.next-btn {
  flex: 2;
}
