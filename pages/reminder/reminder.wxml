<view class="container container--no-tabbar">
  <view class="page-header">
    <view class="g-flex-between">
      <view class="back-btn" bindtap="onBack">
        <text class="iconfont icon-arrow-left iconfont--primary iconfont--sm"></text>
      </view>
      <view class="page-header__title">提醒设置</view>
      <view class="page-header__placeholder"></view>
    </view>
  </view>

  <view class="g-spacer-md"></view>

  <view class="settings-section">
    <view class="settings-section__title">提醒开关</view>
    <view class="g-card">
      <view class="switch-row">
        <view class="switch-row__content">
          <view class="switch-row__title">开启提醒</view>
          <view class="switch-row__desc">注射日按时提醒你注射</view>
        </view>
        <view class="g-switch {{enabled ? 'g-switch--active' : ''}}" bindtap="onSwitchChange">
          <view class="g-switch__thumb"></view>
        </view>
      </view>
    </view>
  </view>

  <block wx:if="{{enabled}}">
    <view class="g-spacer-md"></view>

    <view class="settings-section">
      <view class="settings-section__title">提醒时间</view>
      <view class="g-card">
        <picker mode="time" value="{{time}}" bindchange="onTimeChange">
          <view class="form-row">
            <view class="form-row__label">提醒时间</view>
            <view class="form-row__value">
              <text>{{time}}</text>
              <text class="form-row__arrow">›</text>
            </view>
          </view>
        </picker>
        <view class="form-divider"></view>
        <picker range="{{advanceOptions}}" value="{{advanceIndex}}" bindchange="onAdvanceChange">
          <view class="form-row">
            <view class="form-row__label">提前提醒</view>
            <view class="form-row__value">
              <text>{{advance}}分钟</text>
              <text class="form-row__arrow">›</text>
            </view>
          </view>
        </picker>
      </view>
    </view>

    <view class="g-spacer-sm"></view>

    <view class="settings-section">
      <view class="reminder-tip-card">
        <text class="iconfont icon-bell iconfont--primary iconfont--sm"></text>
        <text class="reminder-tip-card__text">将在注射日的 {{time}}（提前{{advance}}分钟）提醒你注射</text>
      </view>
    </view>

    <view class="g-spacer-sm"></view>

    <view class="settings-section">
      <view class="settings-section__title">微信订阅提醒</view>
      <view class="g-card">
        <view class="subscribe-row">
          <view class="subscribe-row__info">
            <view class="subscribe-row__desc">
              <block wx:if="{{subscribed}}">
                <text class="iconfont icon-check iconfont--success iconfont--sm"></text>
                <text class="subscribe-status-text subscribe-status-text--ok">已授权</text>
              </block>
              <block wx:else>
                <text class="iconfont icon-circle iconfont--muted iconfont--sm"></text>
                <text class="subscribe-status-text">未授权</text>
              </block>
            </view>
          </view>
         <!--<view
            wx:if="{{!subscribed}}"
            class="g-btn g-btn--secondary subscribe-btn"
            bindtap="onSubscribe"
          >
            开启微信提醒
          </view>--> 
        </view>
        <view class="subscribe-hint" wx:if="{{!subscribed}}">
          保存时将自动请求微信订阅授权
        </view>
      </view>
    </view>
  </block>

  <view class="g-spacer-lg"></view>
  <view class="g-spacer-md"></view>

  <view class="save-btn-wrap">
    <view class="g-btn g-btn--primary" bindtap="onSave">保存</view>
  </view>

  <view class="g-spacer-lg"></view>
</view>
