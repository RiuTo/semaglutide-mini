.form-row {
  display: flex;
  align-items: center;
  padding: var(--s-2) 0;
  border-bottom: 1rpx solid var(--c-divider);
  gap: var(--s-2);
}

.form-row:last-of-type {
  border-bottom: none;
}

.form-label {
  width: calc(var(--s-5) + var(--s-4));
  font-size: var(--f-body);
  color: var(--c-text-2);
  font-weight: var(--fw-medium);
  flex-shrink: 0;
  line-height: var(--lh-relaxed);
}

.form-input {
  font-size: var(--f-body);
  color: var(--c-text);
  font-weight: var(--fw-regular);
  line-height: var(--lh-relaxed);
}

.form-value {
  font-size: var(--f-body);
  font-weight: var(--fw-medium);
  line-height: var(--lh-relaxed);
}

.form-unit {
  font-size: var(--f-caption);
  color: var(--c-text-3);
  flex-shrink: 0;
  line-height: var(--lh-relaxed);
}

.form-save {
  margin-top: var(--s-3);
}

.record-values {
  display: flex;
  gap: var(--s-3);
  margin-top: var(--s-1);
  flex-wrap: wrap;
}

.record-val {
  display: flex;
  align-items: baseline;
  gap: var(--s-1);
}

.record-num {
  font-size: var(--f-body);
  font-weight: var(--fw-medium);
  line-height: var(--lh-relaxed);
}

.record-note {
  margin-top: var(--s-1);
  line-height: var(--lh-relaxed);
  color: var(--c-text-2);
}
