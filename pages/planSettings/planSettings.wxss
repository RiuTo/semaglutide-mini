.container {
  min-height: 100vh;
  background: var(--c-bg);
  padding-bottom: var(--s-5);
}

.settings-section {
  padding: 0 var(--gutter);
}

.settings-section__title {
  font-size: var(--f-caption);
  color: var(--c-text-2);
  font-weight: var(--fw-medium);
  margin-bottom: var(--s-2);
  padding-left: var(--s-1);
  letter-spacing: 1rpx;
}

/* ===== Plan Type Cards ===== */
.plan-type-row {
  display: flex;
  gap: var(--s-2);
}

.plan-type-card {
  flex: 1;
  background: var(--c-surface);
  border-radius: var(--r-lg);
  padding: var(--s-3) var(--s-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s-1);
  box-shadow: var(--shadow-card);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.plan-type-card.active {
  background: var(--c-primary-container);
  border-color: var(--c-primary-light);
}

.plan-type-card__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-md);
  background: var(--c-primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-type-card.active .plan-type-card__icon {
  background: var(--c-surface);
}

.plan-type-card__name {
  font-size: var(--f-body);
  color: var(--c-text);
  font-weight: var(--fw-medium);
  line-height: var(--lh-none);
}

.plan-type-card__desc {
  font-size: var(--f-caption);
  color: var(--c-muted);
  line-height: var(--lh-none);
}

/* ===== Drug List ===== */
.drug-list {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}

.drug-card {
  background: var(--c-surface);
  border-radius: var(--r-lg);
  padding: var(--s-2) var(--s-2);
  display: flex;
  align-items: center;
  gap: var(--s-2);
  box-shadow: var(--shadow-card);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.drug-card.active {
  background: var(--c-primary-container);
  border-color: var(--c-primary-light);
}

.drug-card__icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-md);
  background: var(--c-primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.drug-card.active .drug-card__icon {
  background: var(--c-surface);
}

.drug-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.drug-card__name {
  font-size: var(--f-body);
  color: var(--c-text);
  font-weight: var(--fw-medium);
  line-height: var(--lh-none);
}

.drug-card__desc {
  font-size: var(--f-caption);
  color: var(--c-muted);
  line-height: var(--lh-none);
}

.drug-card__check {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ===== Spec Grid ===== */
.spec-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s-2);
}

.spec-card {
  background: var(--c-surface);
  border-radius: var(--r-lg);
  padding: var(--s-3) var(--s-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: var(--shadow-card);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.spec-card.active {
  background: var(--c-primary-container);
  border-color: var(--c-primary-light);
}

.spec-card__dose {
  font-size: 36rpx;
  color: var(--c-text);
  font-weight: var(--fw-medium);
  line-height: var(--lh-none);
}

.spec-card.active .spec-card__dose {
  color: var(--c-primary);
}

.spec-card__desc {
  font-size: var(--f-caption);
  color: var(--c-text-2);
  line-height: var(--lh-none);
}

.spec-card__form {
  font-size: var(--f-small);
  color: var(--c-muted);
  line-height: var(--lh-none);
}

/* ===== Form Card ===== */
.form-card {
  background: var(--c-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-2) var(--s-2);
}

.form-row__label {
  font-size: var(--f-body);
  color: var(--c-text);
  font-weight: var(--fw-medium);
}

.form-row__value {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  font-size: var(--f-body);
  color: var(--c-text-2);
}

.form-row__arrow {
  color: var(--c-muted);
  font-size: 32rpx;
  line-height: 1;
}

.form-divider {
  height: 1rpx;
  background: var(--c-divider);
  margin: 0 var(--s-2);
}

/* ===== Save Button ===== */
.save-btn-wrap {
  padding: 0 var(--gutter);
}

.save-btn-wrap .g-btn {
  width: 100%;
}
