/* ===== Section ===== */
.settings-section {
  padding: 0 var(--gutter);
}

/* ===== Record Form ===== */
.record-form {
  padding: var(--s-2);
}

.record-form__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-2) 0;
}

.record-form__row:first-child {
  padding-top: 0;
}

.record-form__row:last-child {
  padding-bottom: 0;
}

.record-form__label {
  font-size: var(--f-body);
  color: var(--c-text);
  font-weight: var(--fw-medium);
}

.record-form__input-wrap {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  background: var(--c-bg);
  border-radius: var(--r-md);
  padding: var(--s-1) var(--s-2);
  border: 1rpx solid var(--c-divider);
}

.record-form__input {
  width: 160rpx;
  font-size: var(--f-body);
  color: var(--c-text);
  text-align: right;
}

.record-form__unit {
  font-size: var(--f-caption);
  color: var(--c-text-2);
}

.record-form__picker {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  font-size: var(--f-body);
  color: var(--c-text-2);
}

.record-form__arrow {
  color: var(--c-muted);
  font-size: 32rpx;
  line-height: 1;
}

/* ===== Chart Container ===== */
.chart-container {
  width: 100%;
  height: 480rpx;
}

.chart-container .ec-canvas {
  width: 100%;
  height: 100%;
}

/* ===== Latest Header ===== */
.latest-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.latest-header__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.latest-header__date {
  font-size: var(--f-body);
  color: var(--c-text-2);
}

.latest-header__value {
  font-size: 40rpx;
  color: var(--c-primary);
  font-weight: var(--fw-medium);
  line-height: var(--lh-tight);
}

.latest-header__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  background: #2563EB;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.2);
}

.latest-header__btn-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}
