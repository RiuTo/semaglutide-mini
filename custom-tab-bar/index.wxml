<view class="tab-bar-wrapper">
  <view class="tab-bar">
    <view
      class="tab-bar-item {{selected === index ? 'active' : ''}}"
      wx:for="{{list}}"
      wx:key="pagePath"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <image class="tab-bar-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit"></image>
      <view class="tab-bar-text">{{item.text}}</view>
    </view>
  </view>
</view>
