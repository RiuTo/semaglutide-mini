/* ===== Fixed Tab Bar ===== */
.tab-bar-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #FFFFFF;
  border-top: 1rpx solid #EFF6FF;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar {
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

/* ===== Tab Items ===== */
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  transition: all 0.25s ease;
}

.tab-bar-item:active {
  opacity: 0.7;
}

/* ===== Tab Icon Image ===== */
.tab-bar-icon {
  width: 40rpx;
  height: 40rpx;
  transition: all 0.25s ease;
}

.tab-bar-item.active .tab-bar-icon {
  transform: scale(1.08);
}

/* ===== Tab Text ===== */
.tab-bar-text {
  font-size: 24rpx;
  color: #94A3B8;
  line-height: 1;
  font-weight: 400;
  letter-spacing: 1rpx;
  transition: all 0.25s ease;
}

.tab-bar-item.active .tab-bar-text {
  color: #2563EB;
  font-weight: 500;
}

