/* ===== Iconfont Font - Base64 ===== */
@font-face {
  font-family: "iconfont";
  src: url('data:application/x-font-truetype;charset=utf-8;base64,') format('truetype');
}

.iconfont {
  font-family: "iconfont" !important;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

